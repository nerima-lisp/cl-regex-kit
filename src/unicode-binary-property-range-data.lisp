  (defun unicode-word-break-class (character)
    "Return the Unicode 17.0.0 Word_Break class for CHARACTER, or NIL for Other."
    (let ((code (char-code character))
          (ranges +unicode-word-break-ranges+)
          (low 0)
          (high (1- (truncate (length +unicode-word-break-ranges+) 3))))
      (loop while (<= low high)
            for middle = (ash (+ low high) -1)
            for index = (* middle 3)
            for lower = (aref ranges index)
            for upper = (aref ranges (1+ index))
            do (cond
                 ((< code lower)
                  (setf high (1- middle)))
                 ((> code upper)
                  (setf low (1+ middle)))
                 (t
                  (return (aref ranges (+ index 2)))))
            finally (return nil))))
)


(in-package #:cl-regex-kit)

;;; Unicode property aliases and range tables are isolated here so the hot
;;; character-class predicates remain small and easy to audit.

(defun range-matches-p (ranges character)
  (let ((code (char-code character)))
    (some
      (lambda (range)
        (<= (car range) code (cdr range)))
      ranges)))


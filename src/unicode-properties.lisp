(defvar *unicode-property-values* nil)

(defun unicode-property-values ()
  "Return the Script, Block, and Age values present in SBCL's Unicode data."
  (or *unicode-property-values*
      (setf *unicode-property-values*
            (let ((scripts (make-hash-table :test #'equal))
                  (blocks (make-hash-table :test #'equal))
                  (ages (make-hash-table :test #'eql)))
              (loop for code below char-code-limit
                    for character = (code-char code)
                    do (setf (gethash
                              (normalized-property-name
                               (symbol-name (sb-unicode:script character)))
                              scripts)
                             t
                             (gethash
                              (normalized-property-name
                               (symbol-name (sb-unicode:char-block character)))
                              blocks)
                             t
                             (gethash (sb-unicode:age character) ages) t))
              (list (loop for value being the hash-keys of scripts collect value)
                    (loop for value being the hash-keys of blocks collect value)
                    (loop for value being the hash-keys of ages collect value))))))

(defun decimal-string-p (string)
  (and (plusp (length string))
       (every #'digit-char-p string)))

(defun parse-age-property-value (value)
  (let* ((version
           (if (and (plusp (length value)) (char-equal (char value 0) #\V))
               (subseq value 1)
               value))
         (separator (position-if (lambda (item) (member item '(#\. #\_))) version))
         (major-text (subseq version 0 separator))
         (minor-text (and separator (subseq version (1+ separator)))))
    (when (and (decimal-string-p major-text)
               (or (null minor-text) (decimal-string-p minor-text)))
      (values (parse-integer major-text)
              (and minor-text (parse-integer minor-text))))))

(defun valid-age-property-p (value)
  (multiple-value-bind (major minor) (parse-age-property-value value)
    (and major
         (or (null minor) (zerop minor))
         (member major (third (unicode-property-values))))))

(defun unicode-property-name-p (name)
  "Return true if NAME denotes a property implemented by this engine."
  (let* ((raw-name (string-upcase name))
         (raw-property (normalized-property-name raw-name))
         (property
           (or (property-value raw-property '("GC=" "GENERALCATEGORY=")) raw-property))
         (script
           (property-value raw-property '("SC=" "SCRIPT=" "SCX=" "SCRIPTEXTENSIONS=")))
         (block
           (or (property-value raw-property '("BLK=" "BLOCK="))
               (and (> (length raw-property) 2)
                    (string= raw-property "IN" :end1 2 :end2 2)
                    (subseq raw-property 2))))
         (age (property-value raw-name '("AGE="))))
    (cond
      (script (member (canonical-script-name script)
                      (first (unicode-property-values)) :test #'string=))
      (block (member block (second (unicode-property-values)) :test #'string=))
      (age (valid-age-property-p age))
      ((member property +unicode-binary-property-names+ :test #'string=) t)
      ((member property +unicode-general-category-property-names+ :test #'string=) t)
      (t (member property (first (unicode-property-values)) :test #'string=)))))

(defun age-property-p (value character)
  (multiple-value-bind (major minor) (parse-age-property-value value)
    (and major
         (or (null minor) (zerop minor))
         (= major (sb-unicode:age character)))))

(defun ascii-hex-digit-p (character)
  "Return true when CHARACTER is an ASCII hexadecimal digit."
  (or (and (char<= #\0 character #\9))
      (and (char<= #\a character #\f))
      (and (char<= #\A character #\F))))

(defun join-control-p (character)
  "Return true when CHARACTER is U+200C or U+200D."
  (member (char-code character) '(#x200c #x200d)))

(defun decode-code-point-ranges (specification)
  "Decode a space-separated hexadecimal range SPECIFICATION."
  (loop with length = (length specification)
        for start = 0 then (1+ end)
        for end = (or (position #\Space specification :start start) length)
        for token = (subseq specification start end)
        for separator = (position #\- token)
        collect (cons (parse-integer token :radix 16 :end separator)
                      (if separator
                          (parse-integer token :radix 16 :start (1+ separator))
                          (parse-integer token :radix 16)))
        while (< end length)))

